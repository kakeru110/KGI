# Copy this file to .env.local and fill in a real value once a Beds24 API
# V2 refresh token is available. Until BEDS24_REFRESH_TOKEN is set, the
# site runs entirely on deterministic dummy data (see src/lib/beds24/client.ts).
#
# Get one: Beds24 dashboard > Marketplace > API > "Generate invite code"
# (needs read/write:bookings, read/write:bookings-personal, read:inventory,
# read:properties, scoped to this property) then exchange the invite code
# via GET https://beds24.com/api/v2/authentication/setup with header
# "code: <invite code>" - the response's refreshToken goes here.

BEDS24_REFRESH_TOKEN=

# Stripe secret key (test mode: sk_test_..., live mode: sk_live_...) used to
# create Checkout Sessions for the in-site booking flow (see
# src/app/api/checkout/route.ts). Get it from the Stripe dashboard:
# Developers > API keys. Never commit a live key - use test mode until the
# full booking flow (including a real Beds24 booking creation) has been
# verified end to end.

STRIPE_SECRET_KEY=

# Signing secret for the Stripe webhook at /api/webhooks/stripe, which
# creates the Beds24 booking when a payment succeeds (this is what makes
# booking creation reliable even if the guest closes their browser right
# after paying, instead of depending on the redirect back to
# /booking/confirm). Register the webhook endpoint's public URL in the
# Stripe dashboard (Developers > Webhooks) for the
# checkout.session.completed event, then paste the signing secret it
# gives you here. For local testing, the Stripe CLI's `stripe listen
# --forward-to localhost:3000/api/webhooks/stripe` prints a temporary
# one instead.

STRIPE_WEBHOOK_SECRET=

# DeepL API key used to auto-translate guest reviews (which arrive in
# whatever language the guest wrote them) into the site's current locale
# (see src/lib/translate.ts). Without this set, reviews are shown in
# their original language rather than failing. Get a free-tier key
# (500,000 chars/month) at https://www.deepl.com/pro-api - free-tier
# keys end in ":fx".

DEEPL_API_KEY=

# Gmail account used to send the /contact page's inquiries (see
# src/lib/email/client.ts and src/app/api/contact/route.ts). Recipient is
# BUSINESS_INFO.email in src/lib/business-info.ts - GMAIL_USER is only the
# sending account, which can be a different address.
#
# GMAIL_APP_PASSWORD is NOT your normal Gmail password - it's a 16-character
# app password. To get one: turn on 2-Step Verification on the Google
# account at https://myaccount.google.com/security, then generate an app
# password at https://myaccount.google.com/apppasswords (choose "Mail" as
# the app). Without both of these set, the contact form returns an error
# instead of silently failing.

GMAIL_USER=
GMAIL_APP_PASSWORD=
